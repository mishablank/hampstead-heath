<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Hampstead Heath and its village</name>
    <open>1</open>
    <description><![CDATA[A self-guided walking audio guide in 24 stops: one anticlockwise loop from Hampstead Underground station, over the top of the Heath to Kenwood and back down past the swimming ponds. The line joins the stops in walking order and is not the path you walk. <a href="https://hampstead-heath.blankm.workers.dev/">Hampstead Heath, read aloud</a>]]></description>
